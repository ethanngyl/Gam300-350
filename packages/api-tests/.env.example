# Settings for api-smoke.sh / api-smoke.bat. Copy this file to ".env" in
# this folder (packages/api-tests/.env) and fill it in. ".env" is gitignored:
# never commit a real password.

# The backend to test: your own machine, or the shared site's address.
API_BASE_URL=http://localhost:5005
# An existing account on that backend (make a test account for this).
API_EMAIL=you@example.com
API_PASSWORD=your-password

# Optional. A folder with 8 or more .jpg / .png photos: they are uploaded as a
# new job, which is then cancelled and deleted straight away.
# API_UPLOAD_DIR=C:/path/to/photos
# Optional. 1 = also send one feedback message (it is stored for the admins).
# API_SEND_FEEDBACK=1
