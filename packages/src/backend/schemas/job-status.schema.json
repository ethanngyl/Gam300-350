{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "job-status.schema.json",
  "title": "Job status record (jobs/<id>/status.json), version 1",
  "description": "The saved state of one reconstruction job (status.js), read back at startup by scan.js. Dates are UTC epoch milliseconds; result is relative to the jobs folder. Readers ignore fields they don't know, so adding an optional field doesn't need a new version; removing or changing one does (add an upgrade in status.js).",
  "type": "object",
  "required": ["version", "id", "status"],
  "properties": {
    "version": { "const": 1 },
    "id": { "type": "string", "pattern": "^[\\w-]+$" },
    "status": { "enum": ["queued", "running", "done", "error", "cancelled"] },
    "phase": { "type": ["string", "null"] },
    "progress": { "type": "number", "minimum": 0, "maximum": 1 },
    "detail": { "type": ["string", "null"] },
    "error": { "type": ["string", "null"] },
    "source": { "type": ["string", "null"] },
    "name": { "type": ["string", "null"], "maxLength": 80 },
    "sampleFile": { "type": ["string", "null"] },
    "imageCount": { "type": ["integer", "null"], "minimum": 0 },
    "removeBackground": { "type": "boolean" },
    "trainIters": { "type": ["integer", "null"], "minimum": 1 },
    "createdAt": { "type": "number" },
    "updatedAt": { "type": "number" },
    "result": { "type": ["string", "null"] },
    "logTail": { "type": "array", "items": { "type": "string" } }
  }
}
