# Per-machine backend settings: every setting the backend reads (config.js).
# Copy this file to ".env" in this same folder (packages/src/backend/.env)
# and fill in what you need. ".env" is gitignored: never commit it, and never
# put a real key, password or server address in this example file.
#
# Without a .env the backend runs in "local" mode with the defaults shown:
# accounts are stored in this machine's own database, exactly as before the
# VM existed. Lines starting with # are off; remove the # to use one.

# ---------------------------------------------------------------------------
# Any machine
# ---------------------------------------------------------------------------
# HTTP port the website and API are served on (default 5005).
# PORT=5005
# Where job folders (photos, COLMAP files, models) are kept (default: jobs/
# next to this file).
# JOBS_DIR=C:/path/to/jobs
# Every finished model is also copied here for the engine's samples browser
# (default: engine/assets/samples in this repo).
# ENGINE_SAMPLES_DIR=C:/path/to/engine/assets/samples
# This machine's name, shown as each shared job's origin (default: computer name).
# MACHINE_NAME=bryans-pc

# ---------------------------------------------------------------------------
# On the VM (the one machine that holds every account)
# ---------------------------------------------------------------------------
# AUTH_MODE=authority
# AUTH_API_KEY=paste-the-shared-key-here
# Caddy forwards HTTPS traffic from the same machine:
# TRUST_PROXY=loopback
# Keep finished jobs' photos and models inside the database (data/app.db)
# instead of as files in jobs/<id>/images/ and jobs/<id>_out/result.ply, with
# no model copies in engine/assets/samples/. The first start moves existing
# ones in, after backing up the database. metrics.json and covers stay as
# files. VM only: other machines always keep files.
# FILE_STORE=db
# Refuse jobs sent by other machines when less than this much disk is free (GB).
# MIN_FREE_DISK_GB=2
#
# Automatic clean-up (VM only). Keeps stored jobs (photos + models) under
# this many GB by deleting whole jobs, oldest first, down to 90% of it.
# Not set / 0: jobs are never deleted. 20 suits the 40 GB VM. Jobs from the
# last CLEANUP_MIN_AGE_DAYS days and running jobs are never deleted.
# app.db doesn't shrink when jobs are deleted: SQLite reuses the space for
# new jobs, so it levels off around the budget. Backups (data/app.db.bak-*)
# are not counted or deleted; remove old ones by hand.
# STORAGE_BUDGET_GB=20
# CLEANUP_MIN_AGE_DAYS=7
# Feedback older than this many days is deleted (0 = keep forever).
# FEEDBACK_KEEP_DAYS=365
# How often to check, in minutes (it also checks after each new job).
# CLEANUP_INTERVAL_MIN=60
#
# Google sign-in (VM only). From the Google Cloud Console OAuth client. These
# are secrets: they go in the VM's .env only, never in git or chat. Leave the
# client id empty to turn Google sign-in off. The redirect URI must exactly
# match one registered in the console: https://<the VM's address>/auth/google/callback
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=https://your-vm.example/auth/google/callback
# Google's own OAuth endpoints. Only change them to test against a fake Google.
# GOOGLE_AUTH_URL=https://accounts.google.com/o/oauth2/v2/auth
# GOOGLE_TOKEN_URL=https://oauth2.googleapis.com/token

# ---------------------------------------------------------------------------
# On every other machine (sends signup / login to the VM)
# ---------------------------------------------------------------------------
# WARNING: the first start in client mode backs up data/app.db and then
# DELETES this machine's local accounts. Their uploads become admin-only.
# Ask the team for the VM's address and the shared key; there is no default.
# AUTH_MODE=client
# AUTH_API_KEY=paste-the-same-shared-key-here
# VM_AUTH_URL=https://your-vm.example
#
# Shared library: finished jobs are sent to the VM automatically.
# How often unsent jobs are retried, in minutes (default 5):
# SYNC_INTERVAL_MIN=5
#
# Only while testing before HTTPS works on the VM (sends passwords unencrypted):
# AUTH_ALLOW_HTTP=1
# VM_AUTH_URL=http://your-vm-ip:5005

# ---------------------------------------------------------------------------
# Make a shared key once and give the same value to every machine, privately:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Reconstruction (any machine)
# ---------------------------------------------------------------------------
# Tools. Found automatically in tools/ (start.bat downloads them), then
# ../gsplat-tools, then PATH; set these to use a copy installed elsewhere.
# COLMAP_BIN=C:/path/to/colmap.exe
# BRUSH_BIN=C:/path/to/brush_app.exe
# Python for the tools/ scripts (default: the first python on PATH that
# isn't the Microsoft Store stub). Needs Python 3.10 to 3.14.
# PYTHON_BIN=C:/path/to/python.exe
#
# COLMAP's GPU feature extraction / matching: 1 or 0 (default: on when this
# COLMAP build has CUDA and an NVIDIA GPU is found).
# COLMAP_USE_GPU=1
# COLMAP option names: 1 = 3.x (SiftExtraction...), 0 = 4.x
# (FeatureExtraction...). Default: asked from the installed COLMAP.
# COLMAP_LEGACY_FLAGS=0
# Stricter COLMAP matching is on by default; it stops ghost copies on
# low-texture objects. Set to 0 if a photo set fails with "could not build a
# model" and you want to retry with COLMAP's looser defaults.
# COLMAP_STRICT=0
#
# Training iterations when a request doesn't say (the website always sends
# 5,000 / 7,000 / 10,000; see README.txt). Default 10000.
# TRAIN_ITERS=10000
# Brush's iteration-count flag name. Default: asked from the installed Brush.
# BRUSH_ITERS_FLAG=--total-train-iters
# Largest photo side Brush trains at, in pixels (default 1024).
# MAX_RESOLUTION=1024
#
# Frame Extractor: frames per second pulled from each video (default 2), the
# most frames per job (default 200), the largest file accepted in MB (default
# 2048; FrameExtractor.jsx checks the same) and how long extraction may run
# in minutes (default 30). Uploaded videos are deleted once their frames are
# extracted.
# FRAME_FPS=2
# FRAME_MAX_FRAMES=200
# MAX_MEDIA_SIZE_MB=2048
# FRAME_TIMEOUT_MIN=30
#
# Background removal model used by "Remove background" (default isnet-general-use).
# MASK_MODEL=isnet-general-use
#
# The tools/ scripts, if you keep a changed copy elsewhere (defaults: tools/).
# FRAME_SCRIPT=C:/path/to/extract_frames.py
# MASK_SCRIPT=C:/path/to/make_masks.py
# COVER_SCRIPT=C:/path/to/make_cover.py
# NORMALIZE_SCRIPT=C:/path/to/normalize_ply.py
