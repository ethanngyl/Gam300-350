# Per-machine backend settings.
# Copy this file to ".env" in this same folder (packages/src/backend/.env)
# and fill it in. ".env" is gitignored: never commit the real API key.
#
# Without a .env the backend runs in "local" mode: accounts are stored in
# this machine's own database, exactly as before the VM existed.

# ---------------------------------------------------------------------------
# On the VM (the one machine that holds every account):
# ---------------------------------------------------------------------------
# AUTH_MODE=authority
# AUTH_API_KEY=paste-the-shared-key-here
# Caddy forwards HTTPS traffic from the same machine:
# TRUST_PROXY=loopback
# Keep finished jobs' photos inside the database (data/app.db) instead of as
# files in jobs/<id>/images/. The first start moves existing photos in, after
# backing up the database. Models stay as files. VM only.
# FILE_STORE=db

# ---------------------------------------------------------------------------
# On every other machine (sends signup / login to the VM):
# ---------------------------------------------------------------------------
# WARNING: the first start in client mode backs up data/app.db and then
# DELETES this machine's local accounts. Their uploads become admin-only.
# AUTH_MODE=client
# AUTH_API_KEY=paste-the-same-shared-key-here
# VM_AUTH_URL=https://51-79-240-131.sslip.io
#
# Shared library: finished jobs are sent to the VM automatically. Optional:
# MACHINE_NAME=bryans-pc          # shown as each job's origin (default: computer name)
# SYNC_INTERVAL_MIN=5             # how often unsent jobs are retried
#
# Only while testing before HTTPS works on the VM (sends passwords unencrypted):
# AUTH_ALLOW_HTTP=1
# VM_AUTH_URL=http://51.79.240.131:5005

# ---------------------------------------------------------------------------
# Make a shared key once and give the same value to every machine, privately:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Reconstruction (any machine):
# ---------------------------------------------------------------------------
# Stricter COLMAP matching is on by default; it stops ghost copies on
# low-texture objects. Set to 0 if a photo set fails with "could not build a
# model" and you want to retry with COLMAP's looser defaults.
# COLMAP_STRICT=0
#
# Largest .mp4 the video extractor accepts, in MB (default 1024). The video is
# deleted as soon as its frames are extracted. Keep MAX_VIDEO_MB in
# web-app/YoutubeIngest.jsx in step with it.
# MAX_VIDEO_MB=1024
