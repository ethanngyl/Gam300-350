venv/
*.egg-info/
.pytest_cache/

# Scan data (photos + generated .ply — large, not source)
/scans/
*.ply

# Extracted images (YouTube frame extractor output — generated, not source):
# per-job working dirs under server/jobs/ hold uploaded/extracted images/,
# and the CLI (tools/youtube_frames.py) writes to ./frames by default.
/server/jobs/
/packages/src/backend/jobs
/packages/src/backend/uploads
/frames/
# ...except the shared sample splat everyone develops against
!/src/engine/assets/samples/sample_splat.ply

# External tools installed locally, never committed (see tools/get-tools.ps1 /
# tools/get-tools.sh). Downloaded per-machine; the server finds them via
# config.js defaults or the COLMAP_BIN / BRUSH_BIN env vars.
/tools/colmap/
/tools/brush/
# macOS: cloudflared binary (no .exe, so *.exe doesn't cover it) and the
# Python virtualenv start.sh creates for the YouTube extractor.
/tools/cloudflared
/tools/.venv/
# Qt SDK downloaded by src/engine/run.bat (aqtinstall), per-machine.
/src/engine/Library/Qt/

# More C++ / tooling
compile_commands.json
.cache/
CTestTestfile.cmake
_deps/          # CMake FetchContent downloads (like node_modules for C++)

# Editors / OS
.idea/
.vscode/*
!.vscode/settings.json
.DS_Store
Thumbs.db